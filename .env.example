# Default development environment. Copy to `.env`.
# BACKEND_MODE is required and explicit: `mock` or `supabase`.
# `mock` needs no Supabase credentials.
BACKEND_MODE=mock

# Required only when BACKEND_MODE=supabase.
# See .env.local.example, .env.staging.example, and .env.production.example.
SUPABASE_URL=
SUPABASE_ANON_KEY=
