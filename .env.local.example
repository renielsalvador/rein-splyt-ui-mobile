# Local Supabase stack from the sibling splyt-api repository.
# Start it there with `npm start`, then read the publishable (anon) key from
# `npm run status`. Never copy a hosted key into this file.
BACKEND_MODE=supabase
# iOS Simulator: http://127.0.0.1:54321
# Android Emulator: http://10.0.2.2:54321
# Physical device: http://<your-lan-ip>:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=paste-the-local-publishable-key-from-npm-run-status
