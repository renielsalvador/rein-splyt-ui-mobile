{
  "name": "ReinSplytUiMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:simulator": "react-native run-ios --simulator='iPhone 17 Pro Max'",
    "lint": "eslint .",
    "start": "react-native start",
    "bundle-install": "bundle install",
    "bund-install-pod": "bundle exec pod install --project-directory=ios",
